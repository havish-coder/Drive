{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000",
  "CloudSync": {
    "Chunking": {
      "Algorithm": "FixedSize",
      "ChunkSize": 4194304,
      "MinSize": 1048576,
      "AvgSize": 4194304,
      "MaxSize": 16777216
    },
    "Pipeline": {
      "Workers": 4,
      "ChannelCapacity": 4
    },
    "Storage": {
      "Mode": "Local",
      "RootPath": "data/blobs",
      "WorkerUrl": "http://localhost:5100"
    },
    "Database": {
      "ConnectionString": "Data Source=data/cloudsync.db"
    }
  }
}
